# ============================================================================
# new-api 环境变量配置文件
# ============================================================================
# 复制本文件为 /usr/local/new-api/.env，程序启动时自动加载
# 完整变量说明见：https://docs.newapi.ai/zh/docs/installation/config-maintenance/environment-variables
# ============================================================================

# ============================================================================
# 必填项
# ============================================================================

# ---- 数据库（阿里云 PostgreSQL）----
# 格式：postgres://用户名:密码@实例地址:端口/数据库名?sslmode=disable
# 阿里云 PG 通常要求 SSL，如报错改为 sslmode=require
SQL_DSN=postgres://<用户名>:<密码>@<实例地址>:<端口>/<数据库名>?sslmode=disable

# ---- 会话密钥（必填）----
# 生成：openssl rand -hex 32
SESSION_SECRET=<请生成32位随机密钥>

# ============================================================================
# 缓存（阿里云 Redis）
# ============================================================================

# Redis 连接串，格式：redis://:密码@实例地址:端口/数据库编号
REDIS_CONN_STRING=redis://:<密码>@<实例地址>:<端口>/0

# 数据同步频率（秒），Redis 与内存缓存同步间隔
SYNC_FREQUENCY=60

# 是否启用内存缓存（true/false），启用后减轻 Redis 压力
MEMORY_CACHE_ENABLED=true

# ============================================================================
# 服务配置
# ============================================================================

# Gin 模式：release（生产）/ debug（开发）
GIN_MODE=release

# 调试模式（true/false），生产环境保持注释或 false
# DEBUG=false

# ============================================================================
# 数据库连接池（可选，默认值已合理）
# ============================================================================

# 最大空闲连接数
# SQL_MAX_IDLE_CONNS=100

# 最大打开连接数
# SQL_MAX_OPEN_CONNS=1000

# 连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60

# 慢查询日志阈值（毫秒），0 关闭，超出 0-3600000 回退默认 200
# SQL_SLOW_THRESHOLD_MS=200

# ============================================================================
# 日志数据库（可选，与主库分离）
# ============================================================================

# 日志数据库连接串（MySQL/PostgreSQL/ClickHouse）
# 留空则日志写入主库
# LOG_SQL_DSN=postgres://<用户名>:<密码>@<实例地址>:<端口>/<日志数据库名>?sslmode=disable

# ============================================================================
# 渠道与任务（可选）
# ============================================================================

# 渠道自动更新频率（秒），留空用默认值
# CHANNEL_UPDATE_FREQUENCY=30

# 渠道测试频率（秒），留空用默认值
# CHANNEL_TEST_FREQUENCY=30

# 批量更新启用（true/false）
# BATCH_UPDATE_ENABLED=true

# 批量更新间隔（秒）
# BATCH_UPDATE_INTERVAL=5

# 异步任务硬超时（分钟），超时未完成的任务标记失败并退款；0 禁用
# TASK_TIMEOUT_MINUTES=1440

# 异步任务连续轮询失败阈值，达到后标记失败并退款
# TASK_POLL_MAX_FAILURES=20

# ============================================================================
# Relay 超时（可选，AI 请求可能较慢）
# ============================================================================

# 所有请求超时（秒），0 不限制
# RELAY_TIMEOUT=0

# 等待上游响应头超时（秒），默认 1800
# RELAY_RESPONSE_HEADER_TIMEOUT=1800

# 流式文本生成首 chunk 超时（秒），默认 30，0 禁用；成功发送请求后计时，首个响应体字节即解除
# 后台「会话与重试」的默认值与按原始模型名配置优先；启用时首字节前不发本地心跳
# RELAY_TTFT_TIMEOUT=30

# 流式无响应超时（秒），默认 300
# STREAMING_TIMEOUT=300

# ============================================================================
# 安全与代理（可选）
# ============================================================================

# 可信反向代理 IP/CIDR（逗号分隔），留空信任私网
# TRUSTED_PROXIES=none
# TRUSTED_PROXIES=127.0.0.1,172.20.0.0/16

# 会话 Cookie 安全设置（生产 HTTPS 建议 true）
# SESSION_COOKIE_SECURE=false

# 可信 HTTPS Origin（逗号分隔），SESSION_COOKIE_SECURE=true 时必须设置
# SESSION_COOKIE_TRUSTED_URL=https://your-domain.com

# 可信任重定向域名（支付回调等），逗号分隔支持子域名
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io

# 密码哈希算法：bcrypt（默认）/ argon2id（更安全，需全节点切换）
# ACCOUNT_PASSWORD_HASH_ALGORITHM=argon2id

# 登录密码 RSA-OAEP 加密（默认关闭，不能替代 HTTPS）
# PASSWORD_LOGIN_ENCRYPTION_ENABLED=true

# ============================================================================
# 监控与调试（可选）
# ============================================================================

# 启用 pprof 性能分析
# ENABLE_PPROF=true

# Umami 统计
# UMAMI_WEBSITE_ID=xxx
# UMAMI_SCRIPT_URL=https://analytics.example.com/script.js

# Google Analytics
# GOOGLE_ANALYTICS_ID=G-xxx

# ============================================================================
# 其他（可选）
# ============================================================================

# 错误日志记录（true/false）
# ERROR_LOG_ENABLED=true
# 记录客户端请求头和供应商响应头（敏感字段脱敏，条数和长度受限），默认关闭
# LOG_REQUEST_HEADERS=false

# 是否统计图片 Token（true/false）
# GET_MEDIA_TOKEN=true

# 非流式请求是否统计图片 Token（true/false）
# GET_MEDIA_TOKEN_NOT_STREAM=false

# 节点类型：master（主）/ slave（从），多节点部署时从节点设 slave
# NODE_TYPE=master

# 生成默认 Token（true/false），首次部署可开启，生成后关闭
# GENERATE_DEFAULT_TOKEN=false

# SQLite 数据库路径（仅当 SQL_DSN 为空时使用）
# SQLITE_PATH=/path/to/sqlite.db
